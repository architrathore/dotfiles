# zmodload zsh/zprof
source ~/.oh-my-zsh/plugins/zsh-defer/zsh-defer.plugin.zsh

autoload -Uz compinit
compinit -u

# Zshrc startup profiler (~/.zsh/profiler.zsh)
#
# Set PROFILE_ZSHRC=1 to enable startup timing.
# Wrap sections with tick / tock "group/label" to measure them.
# Results print at the end of this file via profiler_report.
#
# Thresholds (override before sourcing):
#   PROFILER_WARN_MS=100   -- yellow highlight
#   PROFILER_SLOW_MS=500   -- red highlight
PROFILE_ZSHRC=0
source ~/.zsh/profiler.zsh

# Prevent CPE customizations from overwriting 
# changes made to this file.
STRIPE_DO_NOT_MANAGE=1

### BEGIN STRIPE
# All Stripe related shell configuration
# is at ~/.stripe/shellinit/zshrc and is
# persistently managed by Chef. You shouldn't
# remove this unless you don't want to load
# Stripe specific shell configurations.
#
# Feel free to add your customizations in this
# file (~/.zshrc) after the Stripe config
# is sourced.
if [[ -f ~/.stripe/shellinit/zshrc ]]; then
  tick
  # append  ~/stripe/space-commander/bin/ to PATH so that 
  # "Open in IDE" for devboxes works (it requires sc-ssh-wrapper to 
  # be on the path)
  # __STRIPE_SHELLINIT_ZSH_SKIP_COMPINIT=1
  __STRIPE_SHELLINIT_ZSH_SKIP_PROMPT=1
  export PATH="$HOME/stripe/space-commander/bin:$PATH"
  zsh-defer -t 5 source ~/.stripe/shellinit/zshrc
  # source ~/.stripe/shellinit/zshrc
  tock "zshrc/stripe-shellinit-zshrc"
fi
### END STRIPE


DISABLE_AUTO_UPDATE="true"
DISABLE_MAGIC_FUNCTIONS="true"
DISABLE_COMPFIX="true"


export EDITOR=nvim

# Github host for GH CLI
export GH_HOST=git.corp.stripe.com

# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:/usr/local/bin:$PATH

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""
DISABLE_UNTRACKED_FILES_DIRTY="true"


plugins=(
	git 
	# emotty
	zsh-autosuggestions
  # zsh-fzf-history-search
	zsh-syntax-highlighting
)

tick
source $ZSH/oh-my-zsh.sh 
tock "zshrc/oh-my-zsh.sh"

# XDG_CONFIG_HOME for lazygit etc
export XDG_CONFIG_HOME="$HOME/.config"

# start starship
tick
eval "$(starship init zsh)"
tock "zshrc/starship"

# fzf shell integration
tick
source <(fzf --zsh)
tock "zshrc/fzf"

# -----------------------------
# ---------- Aliases ----------
# -----------------------------
tick
source ~/.zsh/aliases.sh
tock "zshrc/aliases"


# START - Managed by chef cookbook stripe_cpe_bin
alias tc='/usr/local/stripe/bin/test_cookbook'
alias cz='/usr/local/stripe/bin/chef-zero'
alias cookit='tc && cz'
# STOP - Managed by chef cookbook stripe_cpe_bin

# Print profiling results at the end of zshrc load
(( PROFILE_ZSHRC )) && profiler_report

# zprof
