{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  // "snapshot": false,
  "mcp": {
    "toolshed": {
      "type": "local",
      "command": [
        "{{ if eq .chezmoi.os "darwin" }}/Users/architr/stripe/pay-server{{ else }}/pay/src/pay-server{{ end }}/.cursor/toolshed_stdio_shim.sh",
        "cursor"
      ]
    }
  },
  "provider": {
    "stripe-litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Stripe LiteLLM",
      "options": {
        "baseURL": "http://litellm.qa.corp.stripe.com.certproxy.localhost:7891/v1",
        "apiKey": "use_case=development&team=fraud-detection",
        // "setCacheKey": true,
      },
      "models": {
        // Preferred models
        "gpt-5.4": {
          "name": "GPT-5.4",
          "reasoning": true,
          "options": {
            "reasoning": {
              "effort": "medium",
              "summary": "auto"
            }
          },
          "provider": {
            "npm": "@ai-sdk/openai"
          },
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        },
        "claude-opus-4.6": {
          "name": "Claude Opus 4.6",
          "reasoning": true,
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "gemini-3-pro": {
          "name": "Gemini 3 Pro",
          "reasoning": true,
          "limit": {
            "context": 1048576,
            "output": 65535
          }
        },
        // Older / smaller models
        "gpt-5.3-codex": {
          "name": "GPT-5.3 Codex",
          "reasoning": true,
          "options": {
            "reasoning": {
              "effort": "medium",
              "summary": "auto"
            }
          },
          "provider": {
            "npm": "@ai-sdk/openai"
          },
          "limit": {
            "context": 272000,
            "output": 128000
          }
        },
        "gpt-5.2-codex": {
          "name": "GPT-5.2 Codex",
          "reasoning": true,
          "options": {
            "reasoning": {
              "effort": "medium",
              "summary": "auto"
            }
          },
          "provider": {
            "npm": "@ai-sdk/openai"
          },
          "limit": {
            "context": 272000,
            "output": 128000
          }
        },
        "gpt-5.2": {
          "name": "GPT-5.2",
          "reasoning": true,
          "options": {
            "reasoning": {
              "effort": "medium",
              "summary": "auto"
            }
          },
          "provider": {
            "npm": "@ai-sdk/openai"
          },
          "limit": {
            "context": 272000,
            "output": 128000
          }
        },
        "claude-opus-4.5": {
          "name": "Claude Opus 4.5",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 64000
          }
        },
        "claude-sonnet-4.5": {
          "name": "Claude Sonnet 4.5",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 64000
          }
        },
      }
    }
  },
  "model": "stripe-litellm/claude-opus-4.6",
  "enabled_providers": [
    "stripe-litellm",
  ],
  "instructions": [
    "CLAUDE.md",
    "AGENTS.md",
    ".cursor/rules/*.md"
  ]
}
